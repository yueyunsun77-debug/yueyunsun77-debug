"记录无有效温度缺口" -> "合并主动供风路径" [label="sequence",color="#52728C"];
"记录参考规则未批准" -> "合并主动供风路径" [label="sequence",color="#52728C"];
"合并主动供风路径" -> "汇合温控换热" [label="sequence",color="#52728C"];
"汇合温控换热" -> "热边界独立性判断" [label="sequence",color="#52728C"];
"热边界独立性判断" -> "汇总独立空气侧热流" [label="snapshot.independentAirBoundaries",color="#52728C"];
"热边界独立性判断" -> "更新被替换的空气边界" [label="not snapshot.independentAirBoundaries",color="#52728C"];
