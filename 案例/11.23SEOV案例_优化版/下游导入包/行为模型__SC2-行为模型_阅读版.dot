"判定实际供风状态" -> "供风实际建立判断" [label="sequence",color="#52728C"];
"供风实际建立判断" -> "计算主动供风换热量" [label="snapshot.supplyCapabilityAvailable and snapshot.supplyFeedbackValid and snapshot.actualAirflowPositive",color="#52728C"];
"供风实际建立判断" -> "记录供风未实际建立" [label="not (snapshot.supplyCapabilityAvailable and snapshot.supplyFeedbackValid and snapshot.actualAirflowPositive)",color="#52728C"];
"计算主动供风换热量" -> "合并主动供风路径" [label="sequence",color="#52728C"];
"撤销电池供风请求" -> "合并主动供风路径" [label="sequence",color="#52728C"];
