@startuml
skinparam defaultFontName Noto Sans CJK SC
skinparam defaultFontSize 12
skinparam dpi 120
scale max 2400*12000

skin sysmlbw
skinparam monochrome true
skinparam wrapWidth 300
hide circle

comp def "C033" as E1  <<(T,blue) item  def>>  {
##//doc//##
前除霜请求；角色：请求<U+002F>命令；单位：来源未提供或不适用。
}
comp def "C034" as E2  <<(T,blue) item  def>>  {
##//doc//##
前除霜除雾请求；角色：请求<U+002F>命令；单位：来源未提供或不适用。
}
comp def "C035" as E3  <<(T,blue) item  def>>  {
##//doc//##
前风窗除霜除雾控制请求；角色：请求<U+002F>命令；单位：来源未提供或不适用。
}
comp def "C036" as E4  <<(T,blue) item  def>>  {
##//doc//##
加速<U+002F>制动指令；角色：分析数据；单位：来源未提供或不适用。
}
comp def "C037" as E5  <<(T,blue) item  def>>  {
##//doc//##
动力电池荷电状态；角色：反馈<U+002F>实际状态；单位：来源未提供或不适用。
}
comp def "C038" as E6  <<(T,blue) item  def>>  {
##//doc//##
动力需求、能源状态；角色：反馈<U+002F>实际状态；单位：来源未提供或不适用。
}
comp def "C039" as E7  <<(T,blue) item  def>>  {
##//doc//##
发动机启动状态；角色：反馈<U+002F>实际状态；单位：来源未提供或不适用。
}
comp def "C040" as E8  <<(T,blue) item  def>>  {
##//doc//##
发动机已启动、负载转速反馈；角色：反馈<U+002F>实际状态；单位：来源未提供或不适用。
}
@enduml
