"记录后风窗或未知依据缺口" [shape=box,label="记录后风窗或未知依据缺口"];
"处理前风窗控制模式" [shape=box,label="处理前风窗控制模式\nLF-026"];
"仲裁热管理能力请求" [shape=box,label="仲裁热管理能力请求\nLF-023"];
"请求风窗送风模式" [shape=box,label="请求风窗送风模式\nLF-017"];
"请求最大送风量" [shape=box,label="请求最大送风量\nLF-018"];
"请求来源规定的外循环" [shape=box,label="请求来源规定的外循环\nLF-019"];
"保持当前温度设定" [shape=box,label="保持当前温度设定\nLF-021"];
"允许制冷除湿请求" [shape=box,label="允许制冷除湿请求\nLF-020,LF-024"];
