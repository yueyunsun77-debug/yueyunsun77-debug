"不提出环境除湿请求" [shape=box,label="不提出环境除湿请求\nLF-020"];
"记录SOC等于10的边界缺口" [shape=box,label="记录SOC等于10的边界缺口\nLF-024"];
"反馈风窗与空调状态" [shape=box,label="反馈风窗与空调状态\nLF-022"];
"start" -> "获取本周期快照" [label="sequence",color="#52728C"];
"获取本周期快照" -> "是否继续评估" [label="sequence",color="#52728C"];
"是否继续评估" -> "done" [label="snapshot.stopRequested",color="#52728C"];
"是否继续评估" -> "接收风窗请求" [label="not snapshot.stopRequested",color="#52728C"];
"接收风窗请求" -> "风窗请求判断" [label="sequence",color="#52728C"];
"风窗请求判断" -> "处理前风窗控制模式" [label="snapshot.requestKind == WindscreenKind::frontDefrost or snapshot.requestKind == WindscreenKind::frontDemist",color="#52728C"];
"处理前风窗控制模式" -> "并行配置风窗参数" [label="sequence",color="#52728C"];
"风窗请求判断" -> "记录后风窗或未知依据缺口" [label="not (snapshot.requestKind == WindscreenKind::frontDefrost or snapshot.requestKind == WindscreenKind::frontDemist)",color="#52728C"];
"并行配置风窗参数" -> "请求风窗送风模式" [label="parallel",color="#52728C"];
"请求风窗送风模式" -> "汇合风窗参数" [label="sequence",color="#52728C"];
"并行配置风窗参数" -> "请求最大送风量" [label="parallel",color="#52728C"];
"请求最大送风量" -> "汇合风窗参数" [label="sequence",color="#52728C"];
"并行配置风窗参数" -> "请求来源规定的外循环" [label="parallel",color="#52728C"];
"请求来源规定的外循环" -> "汇合风窗参数" [label="sequence",color="#52728C"];
"并行配置风窗参数" -> "保持当前温度设定" [label="parallel",color="#52728C"];
"保持当前温度设定" -> "汇合风窗参数" [label="sequence",color="#52728C"];
"汇合风窗参数" -> "仲裁热管理能力请求" [label="sequence",color="#52728C"];
"仲裁热管理能力请求" -> "环境除湿判断" [label="sequence",color="#52728C"];
"环境除湿判断" -> "低电量许可判断" [label="snapshot.coolingRequestedByEnvironment",color="#52728C"];
"环境除湿判断" -> "不提出环境除湿请求" [label="not snapshot.coolingRequestedByEnvironment",color="#52728C"];
"低电量许可判断" -> "允许制冷除湿请求" [label="snapshot.soc > 10.0 or (snapshot.soc < 10.0 and snapshot.requestKind == WindscreenKind::frontDefrost)",color="#52728C"];
"低电量许可判断" -> "禁止低电量非前除霜制冷" [label="snapshot.soc < 10.0 and snapshot.requestKind != WindscreenKind::frontDefrost",color="#52728C"];
"低电量许可判断" -> "记录SOC等于10的边界缺口" [label="snapshot.soc == 10.0",color="#52728C"];
"允许制冷除湿请求" -> "合并制冷决定" [label="sequence",color="#52728C"];
"禁止低电量非前除霜制冷" -> "合并制冷决定" [label="sequence",color="#52728C"];
"不提出环境除湿请求" -> "合并制冷决定" [label="sequence",color="#52728C"];
"记录SOC等于10的边界缺口" -> "合并制冷决定" [label="sequence",color="#52728C"];
"合并制冷决定" -> "合并风窗路径" [label="sequence",color="#52728C"];
"记录后风窗或未知依据缺口" -> "合并风窗路径" [label="sequence",color="#52728C"];
"合并风窗路径" -> "反馈风窗与空调状态" [label="sequence",color="#52728C"];
"反馈风窗与空调状态" -> "获取本周期快照" [label="feedback",color="#258460"];
}