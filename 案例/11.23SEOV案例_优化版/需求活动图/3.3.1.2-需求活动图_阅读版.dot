digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.22",ranksep="0.4"];
node [fontname="Noto Sans CJK SC",fontsize=10,shape=box,style="rounded,filled",fillcolor="#EFF5FA"];
edge [fontname="Noto Sans CJK SC",fontsize=8];
"start" [shape=circle,label="开始"];
"done" [shape=doublecircle,label="结束"];
"获取本周期快照" [shape=box,label="获取本周期快照\nLF-027"];
"是否继续评估" [shape=diamond,label="是否继续评估"];
"使能条件判断" [shape=diamond,label="使能条件判断"];
"标定有效性判断" [shape=diamond,label="标定有效性判断"];
"过温判断" [shape=diamond,label="过温判断"];
"保护记忆判断" [shape=diamond,label="保护记忆判断"];
"恢复条件判断" [shape=diamond,label="恢复条件判断"];
"合并控制结果" [shape=diamond,label="合并控制结果"];
"判定全部加热许可" [shape=box,label="判定全部加热许可\nLF-001,LF-002,LF-003"];
"抑制电加热请求" [shape=box,label="抑制电加热请求\nLF-004"];
"记录标定参数缺口" [shape=box,label="记录标定参数缺口\nLF-005,LF-006"];
"切断过温加热请求" [shape=box,label="切断过温加热请求\nLF-005"];
"维持保护禁止状态" [shape=box,label="维持保护禁止状态\nLF-006"];
"允许恢复后的加热请求" [shape=box,label="允许恢复后的加热请求\nLF-006,LF-004"];
"允许正常加热请求" [shape=box,label="允许正常加热请求\nLF-004"];
"反馈电加热运行状态" [shape=box,label="反馈电加热运行状态\nLF-007"];
"start" -> "获取本周期快照" [label="sequence",color="#52728C"];
"获取本周期快照" -> "是否继续评估" [label="sequence",color="#52728C"];
"是否继续评估" -> "done" [label="snapshot.stopRequested",color="#52728C"];
"是否继续评估" -> "判定全部加热许可" [label="not snapshot.stopRequested",color="#52728C"];
"判定全部加热许可" -> "使能条件判断" [label="sequence",color="#52728C"];
"使能条件判断" -> "标定有效性判断" [label="snapshot.heatingRequested and snapshot.blowerActive and snapshot.targetTemperature > snapshot.cabinTemperature and snapshot.highVoltageAvailable and not snapshot.vehicleFaultActive and snapshot.soc > 10.0",color="#52728C"];
"使能条件判断" -> "抑制电加热请求" [label="not (snapshot.heatingRequested and snapshot.blowerActive and snapshot.targetTemperature > snapshot.cabinTemperature and snapshot.highVoltageAvailable and not snapshot.vehicleFaultActive and snapshot.soc > 10.0)",color="#52728C"];
"标定有效性判断" -> "过温判断" [label="snapshot.calibrationValid",color="#52728C"];
"标定有效性判断" -> "记录标定参数缺口" [label="not snapshot.calibrationValid",color="#52728C"];
"过温判断" -> "切断过温加热请求" [label="snapshot.heaterTemperature >= snapshot.cutOffTemperature",color="#52728C"];
"过温判断" -> "保护记忆判断" [label="snapshot.heaterTemperature < snapshot.cutOffTemperature",color="#52728C"];
"保护记忆判断" -> "恢复条件判断" [label="snapshot.protectionWasActive",color="#52728C"];
"保护记忆判断" -> "允许正常加热请求" [label="not snapshot.protectionWasActive",color="#52728C"];
"恢复条件判断" -> "允许恢复后的加热请求" [label="snapshot.heaterTemperature <= snapshot.recoveryTemperature",color="#52728C"];
"恢复条件判断" -> "维持保护禁止状态" [label="snapshot.heaterTemperature > snapshot.recoveryTemperature",color="#52728C"];
"抑制电加热请求" -> "合并控制结果" [label="sequence",color="#52728C"];
"记录标定参数缺口" -> "合并控制结果" [label="sequence",color="#52728C"];
"切断过温加热请求" -> "合并控制结果" [label="sequence",color="#52728C"];
"维持保护禁止状态" -> "合并控制结果" [label="sequence",color="#52728C"];
"允许恢复后的加热请求" -> "合并控制结果" [label="sequence",color="#52728C"];
"允许正常加热请求" -> "合并控制结果" [label="sequence",color="#52728C"];
"合并控制结果" -> "反馈电加热运行状态" [label="sequence",color="#52728C"];
"反馈电加热运行状态" -> "获取本周期快照" [label="feedback",color="#258460"];
}