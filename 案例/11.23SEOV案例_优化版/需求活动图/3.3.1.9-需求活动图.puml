E10  --> E38  : [not '获取本周期快照'.coolingRequestedByEnvironment]
E11  --> E34  : ['获取本周期快照'.soc > 10.0 or ('获取本周期快照'.soc < 10.0 and '获取本周期快照'.requestKind == WindscreenKind::frontDefrost)]
E11  --> E36  : ['获取本周期快照'.soc < 10.0 and '获取本周期快照'.requestKind != WindscreenKind::frontDefrost]
E11  --> E40  : ['获取本周期快照'.soc == 10.0]
E34 --> E14  
E36 --> E14  
E38 --> E14  
E40 --> E14  
E14 --> E15  
E18 --> E15  
E15 --> E42  
E42 --> E2  
