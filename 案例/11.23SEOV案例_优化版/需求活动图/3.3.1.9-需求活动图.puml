@startuml
skinparam defaultFontName Noto Sans CJK SC
skinparam defaultFontSize 12
skinparam dpi 120
scale max 2400*12000

skin sysmlbw
skinparam monochrome true
skinparam wrapWidth 300
hide circle
skinparam ranksep 10
skinparam rectangle {
 backgroundColor<<block>> LightGreen
}

rec usage "行为评估流程" as E1  <<(T,blue) action>>  {
rec usage "获取本周期快照" as E2  <<(T,blue) action>>  {
portout "stopRequested" as E4   
portout "requestKind" as E5   
portout "soc" as E6   
portout "coolingRequestedByEnvironment" as E7   
}

choice "是否继续评估" as E8   
choice "风窗请求判断" as E9   
choice "环境除湿判断" as E10   
choice "低电量许可判断" as E11   
fork "并行配置风窗参数" as E12   
join "汇合风窗参数" as E13   
choice "合并制冷决定" as E14   
choice "合并风窗路径" as E15   
rec usage "接收风窗请求" as E16  <<(T,blue) action>>  {
}

rec usage "记录后风窗或未知依据缺口" as E18  <<(T,blue) action>>  {
}

rec usage "处理前风窗控制模式" as E20  <<(T,blue) action>>  {
}

rec usage "仲裁热管理能力请求" as E22  <<(T,blue) action>>  {
}

rec usage "请求风窗送风模式" as E26  <<(T,blue) action>>  {
}

rec usage "请求最大送风量" as E28  <<(T,blue) action>>  {
}

rec usage "请求来源规定的外循环" as E30  <<(T,blue) action>>  {
}

rec usage "保持当前温度设定" as E32  <<(T,blue) action>>  {
}

rec usage "允许制冷除湿请求" as E34  <<(T,blue) action>>  {
}

rec usage "禁止低电量非前除霜制冷" as E36  <<(T,blue) action>>  {
}

rec usage "不提出环境除湿请求" as E38  <<(T,blue) action>>  {
}

rec usage "记录SOC等于10的边界缺口" as E40  <<(T,blue) action>>  {
}

rec usage "反馈风窗与空调状态" as E42  <<(T,blue) action>>  {
}

[*] --> E2  
E8 --> [*]  : ['获取本周期快照'.stopRequested]
}

note as E3
功能引用：行为适配/上下文。
end note 
note as E17
功能引用：LF-016。
end note 
note as E19
功能引用：行为适配/上下文。
end note 
note as E21
功能引用：LF-026。
end note 
note as E23
功能引用：LF-023。
end note 
note as E24
前除霜 > 电池高温冷却 > 座舱制冷 > 电池非高温冷却。电池高温分界XX及完整仲裁算法仍待定义；本节点保留该功能契约，不擅自用35℃补值。
end note 
note as E25
本节点属性是行为决策所需的分析投影，不重新定义继承的概念级输出端口。
end note 
note as E27
功能引用：LF-017。
