"用户操作判断" -> "记录重复AUTO语义缺口" [label="snapshot.operation == AutoOperation::autoRepeat",color="#52728C"];
"用户操作判断" -> "保持当前自动控制" [label="snapshot.operation == AutoOperation::noChange",color="#52728C"];
"更新温度并保持AUTO" -> "合并模式结果" [label="sequence",color="#52728C"];
"保持AUTO循环操作" -> "合并模式结果" [label="sequence",color="#52728C"];
