value: Boolean
}
comp def "C127" as E7  <<(T,blue) item  def>>  {
##//doc//##
电池主动供风请求及供风可用状态；角色：请求<U+002F>命令；单位：来源未提供或不适用。
}
comp def "C128" as E8  <<(T,blue) item  def>>  {
##//doc//##
电池主动冷却请求；角色：请求<U+002F>命令；单位：来源未提供或不适用。
