digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.22",ranksep="0.4"];
node [fontname="Noto Sans CJK SC",fontsize=10,shape=box,style="rounded,filled",fillcolor="#EFF5FA"];
edge [fontname="Noto Sans CJK SC",fontsize=8];
"start" [shape=circle,label="开始"];
"done" [shape=doublecircle,label="结束"];
"获取本周期快照" [shape=box,label="获取本周期快照"];
"是否继续评估" [shape=diamond,label="是否继续评估"];
"驾驶意图判断" [shape=diamond,label="驾驶意图判断"];
"回收可用性判断" [shape=diamond,label="回收可用性判断"];
"发电需求判断" [shape=diamond,label="发电需求判断"];
"发动机状态判断" [shape=diamond,label="发动机状态判断"];
"启动完成判断" [shape=diamond,label="启动完成判断"];
"并行驱动与发电" [shape=rect,label="并行驱动与发电"];
"合并驾驶路径" [shape=diamond,label="合并驾驶路径"];
"合并发电路径" [shape=diamond,label="合并发电路径"];
"汇合能量路径" [shape=rect,label="汇合能量路径"];
"接收驾驶指令" [shape=box,label="接收驾驶指令\nS1-F01"];
"分析动力需求" [shape=box,label="分析动力需求\nS1-F02"];
"选择运行模式" [shape=box,label="选择运行模式\nS1-F03"];
"执行电驱动请求" [shape=box,label="执行电驱动请求\nS1-F04"];
"判定再生制动请求" [shape=box,label="判定再生制动请求\nS1-F05"];
"协调再生充电" [shape=box,label="协调再生充电\nS1-F06"];
"调节发电工作点" [shape=box,label="调节发电工作点\nS1-F08"];
"管理充电能量收支" [shape=box,label="管理充电能量收支\nS1-F09"];
"反馈并更新模式评估" [shape=box,label="反馈并更新模式评估\nS1-F10"];
"协调发动机启动" [shape=box,label="协调发动机启动\nS1-F07"];
"记录加速制动冲突" [shape=box,label="记录加速制动冲突"];
"记录回收不可用" [shape=box,label="记录回收不可用"];
"保持无驱动制动请求" [shape=box,label="保持无驱动制动请求"];
"记录发动机启动未完成" [shape=box,label="记录发动机启动未完成"];
"保持无发电请求" [shape=box,label="保持无发电请求"];
"start" -> "获取本周期快照" [label="sequence",color="#52728C"];
"获取本周期快照" -> "是否继续评估" [label="sequence",color="#52728C"];
"是否继续评估" -> "done" [label="snapshot.stopRequested",color="#52728C"];
"是否继续评估" -> "接收驾驶指令" [label="not snapshot.stopRequested",color="#52728C"];
"接收驾驶指令" -> "分析动力需求" [label="sequence",color="#52728C"];
"分析动力需求" -> "选择运行模式" [label="sequence",color="#52728C"];
"选择运行模式" -> "并行驱动与发电" [label="sequence",color="#52728C"];
"并行驱动与发电" -> "驾驶意图判断" [label="parallel",color="#52728C"];
"并行驱动与发电" -> "发电需求判断" [label="parallel",color="#52728C"];
"驾驶意图判断" -> "执行电驱动请求" [label="snapshot.driveRequested and not snapshot.brakeRequested",color="#52728C"];
"驾驶意图判断" -> "判定再生制动请求" [label="snapshot.brakeRequested and not snapshot.driveRequested",color="#52728C"];
"驾驶意图判断" -> "记录加速制动冲突" [label="snapshot.driveRequested and snapshot.brakeRequested",color="#52728C"];
"驾驶意图判断" -> "保持无驱动制动请求" [label="not snapshot.driveRequested and not snapshot.brakeRequested",color="#52728C"];
"判定再生制动请求" -> "回收可用性判断" [label="sequence",color="#52728C"];
"回收可用性判断" -> "协调再生充电" [label="snapshot.regenAvailable and snapshot.batteryAcceptsCharge",color="#52728C"];
"回收可用性判断" -> "记录回收不可用" [label="not (snapshot.regenAvailable and snapshot.batteryAcceptsCharge)",color="#52728C"];
"执行电驱动请求" -> "合并驾驶路径" [label="sequence",color="#52728C"];
"协调再生充电" -> "合并驾驶路径" [label="sequence",color="#52728C"];
"记录加速制动冲突" -> "合并驾驶路径" [label="sequence",color="#52728C"];
"记录回收不可用" -> "合并驾驶路径" [label="sequence",color="#52728C"];
"保持无驱动制动请求" -> "合并驾驶路径" [label="sequence",color="#52728C"];
"发电需求判断" -> "发动机状态判断" [label="snapshot.generationRequested",color="#52728C"];
"发电需求判断" -> "保持无发电请求" [label="not snapshot.generationRequested",color="#52728C"];
"发动机状态判断" -> "调节发电工作点" [label="snapshot.engineRunning",color="#52728C"];
"发动机状态判断" -> "协调发动机启动" [label="not snapshot.engineRunning",color="#52728C"];
"协调发动机启动" -> "启动完成判断" [label="sequence",color="#52728C"];
"启动完成判断" -> "调节发电工作点" [label="'协调发动机启动'.startCompleted",color="#52728C"];
"启动完成判断" -> "记录发动机启动未完成" [label="not '协调发动机启动'.startCompleted",color="#52728C"];
"调节发电工作点" -> "合并发电路径" [label="sequence",color="#52728C"];
"记录发动机启动未完成" -> "合并发电路径" [label="sequence",color="#52728C"];
"保持无发电请求" -> "合并发电路径" [label="sequence",color="#52728C"];
"合并驾驶路径" -> "汇合能量路径" [label="sequence",color="#52728C"];
"合并发电路径" -> "汇合能量路径" [label="sequence",color="#52728C"];
"汇合能量路径" -> "管理充电能量收支" [label="sequence",color="#52728C"];
"管理充电能量收支" -> "反馈并更新模式评估" [label="sequence",color="#52728C"];
"反馈并更新模式评估" -> "获取本周期快照" [label="feedback",color="#258460"];
}