E51 .. E50  
E2 --> E11  
E11  --> E21  : [not '获取本周期快照'.stopRequested]
E21 --> E23  
E23 --> E25  
E25 --> E17  
E17 --> E12  
E17 --> E14  
E12  --> E27  : ['获取本周期快照'.driveRequested and not '获取本周期快照'.brakeRequested]
E12  --> E29  : ['获取本周期快照'.brakeRequested and not '获取本周期快照'.driveRequested]
E12  --> E42  : ['获取本周期快照'.driveRequested and '获取本周期快照'.brakeRequested]
E12  --> E46  : [not '获取本周期快照'.driveRequested and not '获取本周期快照'.brakeRequested]
E29 --> E13  
E13  --> E31  : ['获取本周期快照'.regenAvailable and '获取本周期快照'.batteryAcceptsCharge]
E13  --> E44  : [not ('获取本周期快照'.regenAvailable and '获取本周期快照'.batteryAcceptsCharge)]
E27 --> E18  
E31 --> E18  
E42 --> E18  
E44 --> E18  
E46 --> E18  
E14  --> E15  : ['获取本周期快照'.generationRequested]
E14  --> E50  : [not '获取本周期快照'.generationRequested]
E15  --> E33  : ['获取本周期快照'.engineRunning]
E15  --> E39  : [not '获取本周期快照'.engineRunning]
E39 --> E16  
E16  --> E33  : ['协调发动机启动'.startCompleted]
E16  --> E48  : [not '协调发动机启动'.startCompleted]
E33 --> E19  
E48 --> E19  
E50 --> E19  
E18 --> E20  
E19 --> E20  
E20 --> E35  
E35 --> E37  
E37 --> E2  
@enduml
