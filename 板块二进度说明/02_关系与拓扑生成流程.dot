 edge [color="#587188",fontname="Noto Sans CJK SC",fontsize=10];
label="关系标注与逻辑拓扑生成（基于 MBSE_all.py）";labelloc=t;
a[label="遍历去重后的功能关系"];
b[shape=diamond,label="两端功能ID均存在？"];
