digraph G {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.25,ranksep=0.35,fontname="Noto Sans CJK SC",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#EAF2FA",color="#38658A",fontname="Noto Sans CJK SC",fontsize=12,margin="0.18,0.12"];
 edge [color="#587188",fontname="Noto Sans CJK SC",fontsize=10];
label="板块二：逻辑功能架构数据生成流程（整合设计）"; labelloc=t;
a[label="板块一输出
补全后的功能点、关系、摘要"];
b[label="JSON → 输入三表
功能点列表 / 功能点关系图 / 摘要信息"];
