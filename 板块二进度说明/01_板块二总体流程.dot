digraph G {
graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.3,ranksep=0.4,fontname="Noto Sans CJK SC",fontsize=19];
node [shape=box,style="rounded,filled",fillcolor="#EAF2FA",color="#38658A",fontname="Noto Sans CJK SC",fontsize=12,margin="0.18,0.12"];
edge [color="#587188",fontname="Noto Sans CJK SC",fontsize=10];
label="板块二处理流程与交付边界";labelloc=t;
a[label="板块一\n输出功能点及其关联关系数据"];
z[label="板块三：郑心如\n补全功能点及其关联关系数据",fillcolor="#E6F4EA"];
b[label="板块二：接收补全后的数据并适配\nfunctions映射 → function_points数组\nfunction_relations → relations"];
c[shape=diamond,label="模型、ID与引用有效？"];
d[label="报告错误，反馈并修正输入",fillcolor="#FCE8E6"];
e[label="多字段语义特征构建 → BIRCH功能聚类"];
f[label="功能关系分析与拓扑连接生成\n保留聚类归属、关系语义及来源"];
g[label="评价与一致性检查\n记录metrics / processing"];
h[label="板块二输出\n功能逻辑架构数据JSON"];
j[label="板块三周瑜璇\nJSON交接 → SysML v2转换与校验",fillcolor="#E6F4EA"];
i[label="物理架构组件选型及连接布局模块\n对外接口适配与返回（待接入/对齐）",fillcolor="#FFF3CD"];
a->z->b->c;c->d[label="否"];c->e[label="是"];e->f->g->h;h->i;h->j;
}