NOTE [shape=note, fontsize=11, label="一次评估快照；抽象动作不代表实车仿真。\n全部使能：送风开启、目标温度>舱温、高压可用、无整车故障、SOC>10%。\n保护状态由调用方输入，阈值XXX待标定；最终许可受使能与保护共同约束。"];
N19 -> NOTE [style=invis];
}
