N16 -> N10 [arrowhead=vee, label="加热温度 > 待标定恢复温度"];
// successions: recoveryChoice -> 保持保护禁止状态 [heaterTemperature > recoveryTemperature]
N11 -> N18 [arrowhead=vee];
// successions: 停止加热并进入保护 -> protectionMerged []
N12 -> N18 [arrowhead=vee];
// successions: 按当前许可调节输出 -> protectionMerged []
N9 -> N18 [arrowhead=vee];
// successions: 重新允许加热 -> protectionMerged []
N10 -> N18 [arrowhead=vee];
// successions: 保持保护禁止状态 -> protectionMerged []
N18 -> N5 [arrowhead=vee];
