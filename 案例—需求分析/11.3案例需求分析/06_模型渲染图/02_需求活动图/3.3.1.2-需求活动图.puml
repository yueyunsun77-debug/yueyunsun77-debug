@startdot
digraph G {
graph [bgcolor="white", fontname="Noto Sans CJK SC", fontsize=20, labelloc=t, label="3.3.1.2 空调制热 · 需求活动图", pad=0.45, nodesep=0.65, ranksep=1.0, splines=ortho, dpi=150, rankdir=TB, ranksep=0.65, dpi=130];
node [shape=box, style="rounded,filled", fillcolor="white", color="#858585", penwidth=1.1, fontname="Noto Sans CJK SC", fontsize=14, margin="0.18,0.14"];
edge [color="#666666", penwidth=1.0, fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.7];
{rank=same; ON; OFF;}
{rank=same; REC; STOP; KEEP;}
{rank=same; UNLOCK; HOLD;}
A0 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>接收制热请求并读取目标温<BR/>度>];
A1 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>检查电加热使能条件>];
A2 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>根据使能条件控制电加热通<BR/>断>];
A3 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>监测电加热温度并执行过温<BR/>保护>];
A4 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>反馈电加热状态与功率信息>];
ON [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>允许电加热输出>];
OFF [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>禁止或保持关闭加热>];
REC [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>判断保护恢复条件>];
UNLOCK [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>重新允许加热<BR/>仍须满足全部使能条件>];
HOLD [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>保持保护禁止状态>];
STOP [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>停止加热并进入保护>];
KEEP [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>按当前许可调节输出>];
A0 -> A1 [style=dashed, arrowhead=vee];
A1 -> A2 [style=dashed, arrowhead=vee, xlabel="使能条件判断结果"];
A2 -> ON [style=dashed, arrowhead=vee, xlabel="全部条件满足"];
A2 -> OFF [style=dashed, arrowhead=vee, xlabel="任一条件不满足"];
ON -> A3 [style=dashed, arrowhead=vee];
OFF -> A3 [style=dashed, arrowhead=vee];
A3 -> REC [style=dashed, arrowhead=vee, xlabel="已触发且未解除保护"];
A3 -> STOP [style=dashed, arrowhead=vee, xlabel="未处于保护且温度≥上限X\nXX℃"];
A3 -> KEEP [style=dashed, arrowhead=vee, xlabel="未处于保护且未达上限"];
REC -> UNLOCK [style=dashed, arrowhead=vee, xlabel="温度≤恢复XXX℃"];
REC -> HOLD [style=dashed, arrowhead=vee, xlabel="尚未满足恢复条件"];
UNLOCK -> A4 [style=dashed, arrowhead=vee];
HOLD -> A4 [style=dashed, arrowhead=vee];
STOP -> A4 [style=dashed, arrowhead=vee];
KEEP -> A4 [style=dashed, arrowhead=vee];
NOTE [shape=note, style=filled, fillcolor="white", fontsize=11, label="使能：送风开启、目标温度>舱温、高压可用、无整车故障、SOC>10%。\n电加热温度检测50 ms；上限/恢复阈值XXX待标定。\n保留原阶段和doc规则；一次评估片段不代表持续监测停止。"];
A4 -> NOTE [style=invis];
}
@enddot
