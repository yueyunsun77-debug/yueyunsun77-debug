N12 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>按当前许可调节输出>];
N13 [shape=diamond, style=filled, width=1.8, height=0.6, fontsize=11, label="使能条件判断"];
N14 [shape=diamond, style=filled, width=1.8, height=0.6, fontsize=11, label="是否达到过温上限"];
N15 [shape=diamond, style=filled, width=1.8, height=0.6, fontsize=11, label="原保护是否激活"];
N16 [shape=diamond, style=filled, width=1.8, height=0.6, fontsize=11, label="是否达到恢复条件"];
N17 [shape=diamond, style=filled, width=1.8, height=0.6, fontsize=11, label="使能分支合并"];
N18 [shape=diamond, style=filled, width=1.8, height=0.6, fontsize=11, label="保护分支合并"];
N19 [shape=circle, width=0.16, height=0.16, fixedsize=true, style=filled, fillcolor="white", peripheries=2, label=""];
N0 -> N1 [arrowhead=vee];
// successions: start -> 接收制热请求并读取目标温度 []
N5 -> N19 [arrowhead=vee];
