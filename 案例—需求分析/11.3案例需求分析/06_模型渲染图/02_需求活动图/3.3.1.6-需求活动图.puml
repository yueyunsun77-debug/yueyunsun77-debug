@startdot
digraph G {
graph [bgcolor="white", fontname="Noto Sans CJK SC", fontsize=20, labelloc=t, label="3.3.1.6 自动空调模式 · 需求活动图", pad=0.45, nodesep=0.65, ranksep=1.0, splines=ortho, dpi=150, rankdir=TB, ranksep=0.65, dpi=130];
node [shape=box, style="rounded,filled", fillcolor="white", color="#858585", penwidth=1.1, fontname="Noto Sans CJK SC", fontsize=14, margin="0.18,0.14"];
edge [color="#666666", penwidth=1.0, fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.7];
{rank=same; TEMP; MANUAL; DEF; AC; INVALID;}
A0 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>接收AUTO模式请求>];
A1 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>处理请求并反馈AUTO状<BR/>态>];
A2 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>采集环境与温度信号>];
A3 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>协调热量与空气调节服务>];
A4 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>处理用户操作与模式切换>];
A5 [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>更新控制输出并持续反馈状<BR/>态>];
TEMP [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>保持AUTO并更新设置>];
MANUAL [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>退出AUTO<BR/>其余指定项仍自动>];
DEF [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>进入前除霜状态>];
AC [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>关闭制冷请求<BR/>转速请求=0>];
CLOSE [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>AUTO反馈Close <BR/>风量/温度/模式/循环仍<BR/>自动>];
INVALID [width=2.4, height=0.65, label=<<FONT COLOR="#8070AC">▣</FONT> «action»<BR/>重复AUTO操作：inv<BR/>alid 具体交互待确认>];
A0 -> A1 [style=dashed, arrowhead=vee];
A1 -> A2 [style=dashed, arrowhead=vee];
A2 -> A3 [style=dashed, arrowhead=vee];
A3 -> A4 [style=dashed, arrowhead=vee];
A4 -> TEMP [style=dashed, arrowhead=vee, xlabel="温度/循环操作"];
A4 -> MANUAL [style=dashed, arrowhead=vee, xlabel="风量/吹风模式操作"];
A4 -> DEF [style=dashed, arrowhead=vee, xlabel="前除霜操作"];
A4 -> AC [style=dashed, arrowhead=vee, xlabel="AC操作"];
A4 -> INVALID [style=dashed, arrowhead=vee, xlabel="再次AUTO操作"];
AC -> CLOSE [style=dashed, arrowhead=vee];
TEMP -> A5 [style=dashed, arrowhead=vee];
MANUAL -> A5 [style=dashed, arrowhead=vee];
DEF -> A5 [style=dashed, arrowhead=vee];
CLOSE -> A5 [style=dashed, arrowhead=vee];
INVALID -> A5 [style=dashed, arrowhead=vee];
NOTE [shape=note, style=filled, fillcolor="white", fontsize=11, label="温度<16℃为LO，>30℃为HI；每次调节0.5℃。\nAUTO反馈状态与各局部自动控制行为分别表达。\n保留原阶段和doc规则；一次评估片段不代表持续监测停止。"];
A5 -> NOTE [style=invis];
}
@enddot
